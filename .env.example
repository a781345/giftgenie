# Qloo (leave empty to run in mock mode with fixture data)
QLOO_API_KEY=
# Hackathon keys only work against this host (https://api.qloo.com returns 401).
# Override if you are given a different host.
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Optional LLM for the narrative step (any OpenAI-compatible Chat Completions API).
# Leave empty to use the deterministic planner.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

PORT=3000
